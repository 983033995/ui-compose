{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-compose.dev/schemas/source-registry.schema.json",
  "title": "UI Compose Source Registry",
  "type": "object",
  "required": ["version", "updated", "principle", "sources"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "number" },
    "updated": { "type": "string", "format": "date" },
    "principle": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "role",
          "frameworks",
          "jobs",
          "traits",
          "integration",
          "license",
          "provenance",
          "runtime_dependency_default",
          "risks"
        ],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "name": { "type": "string", "minLength": 1 },
          "role": { "$ref": "#/$defs/id" },
          "canonical_url": { "type": "string", "format": "uri" },
          "frameworks": { "$ref": "#/$defs/idList" },
          "jobs": { "$ref": "#/$defs/idList" },
          "traits": { "$ref": "#/$defs/idList" },
          "integration": { "$ref": "#/$defs/id" },
          "license": { "type": "string", "minLength": 1 },
          "provenance": { "type": "string", "minLength": 1 },
          "last_verified": { "type": "string", "format": "date" },
          "runtime_dependency_default": { "type": "boolean" },
          "risks": { "$ref": "#/$defs/idListAllowEmpty" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "idListAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
