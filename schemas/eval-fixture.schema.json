{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-compose.dev/schemas/eval-fixture.schema.json",
  "title": "UI Compose Eval Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "case_ids",
    "framework",
    "runtime",
    "styling",
    "primitive_system",
    "tokens",
    "package_manager",
    "commands",
    "representative_files",
    "required_states",
    "accessibility_contract",
    "mobile_contract"
  ],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "framework": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "styling": { "type": "string", "minLength": 1 },
    "primitive_system": { "type": "string", "minLength": 1 },
    "tokens": { "type": "string", "minLength": 1 },
    "motion": { "type": "string" },
    "package_manager": { "$ref": "#/$defs/id" },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden_default_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "build"],
      "properties": {
        "install": { "type": "string", "minLength": 1 },
        "build": { "type": "string", "minLength": 1 },
        "test": { "type": ["string", "null"] },
        "dev": { "type": ["string", "null"] }
      }
    },
    "representative_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "accessibility_contract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "mobile_contract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "snapshot_ref": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
