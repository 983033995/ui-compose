{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ui-compose.dev/schemas/skeleton-registry.schema.json",
  "title": "UI Compose Skeleton Registry",
  "type": "object",
  "required": ["version", "updated", "principle", "skeletons"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "number" },
    "updated": { "type": "string", "format": "date" },
    "principle": { "type": "string", "minLength": 1 },
    "skeletons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "surface", "jobs", "regions", "desktop", "mobile", "recommended_patterns", "risks"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "surface": { "$ref": "#/$defs/id" },
          "jobs": { "$ref": "#/$defs/idList" },
          "regions": { "$ref": "#/$defs/idList" },
          "desktop": { "$ref": "#/$defs/id" },
          "mobile": { "$ref": "#/$defs/id" },
          "recommended_patterns": { "$ref": "#/$defs/idList" },
          "risks": { "$ref": "#/$defs/idListAllowEmpty" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "idListAllowEmpty": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    }
  }
}
